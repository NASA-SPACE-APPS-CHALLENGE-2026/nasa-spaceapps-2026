# PlotTwist runs with zero API keys. Everything below is optional.

# NASA Earthdata login token (https://urs.earthdata.nasa.gov > Generate Token).
# Needed only for the SMAP soil moisture and GPM IMERG satellite rainfall sources.
# Without it those two show "Not available yet". Put the real value in web/.env.local (never commit it).
# Server-side only: never prefix it with NEXT_PUBLIC_.
EARTHDATA_TOKEN=
